// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  senha     String
  nome      String
  papel      String     @default("docente")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  seguindo   Seguidor[] @relation("Seguindo")
  seguidores Seguidor[] @relation("Seguidores")

  @@index([papel])
  @@map("usuarios")
}

model Post {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  content   String
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("posts")
}

model Comentario {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postUuid  String    @db.Uuid
  autorUuid String    @db.Uuid
  autorNome String
  conteudo  String
  apagado   Boolean   @default(false)
  apagadoEm DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postUuid])
  @@index([postUuid, createdAt(sort: Desc), id(sort: Desc)])
  @@map("comentarios")
}

model Seguidor {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seguidorUuid String   @db.Uuid
  seguidoUuid  String   @db.Uuid
  createdAt    DateTime @default(now())

  seguidor Usuario @relation("Seguindo", fields: [seguidorUuid], references: [uuid], onDelete: Cascade)
  seguido  Usuario @relation("Seguidores", fields: [seguidoUuid], references: [uuid], onDelete: Cascade)

  @@unique([seguidorUuid, seguidoUuid])
  @@index([seguidorUuid])
  @@index([seguidoUuid])
  @@map("seguidores")
}
